# Copy to .env and fill in. Never commit .env.
#
# These are the SAME Supabase project the mobile app uses. The anon key is
# public by design — Row Level Security is what protects the data, not this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Testing only. Shows every trip you host, not just operator ('C') trips.
# Leave unset in production.
VITE_ALLOW_ALL_HOSTED_TRIPS=false
