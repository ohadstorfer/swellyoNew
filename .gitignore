# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Xcode per-user state — window layout, breakpoints, scheme order.
# Machine-local noise: it re-dirties every time Xcode opens.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.pbxuser
*.mode1v3
*.perspectivev3

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

.next/

secret/

# Firebase / FCM credentials — never commit
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json
fcm-service-account.json
# Exception: android/app/google-services.json is required for native Android FCM build.
# It contains only public identifiers (project ID, API key, package name) and is safe to commit.
!android/app/google-services.json
# EAS local credentials — never commit
credentials.json

.env.local

# Sentry — contains the auth token in plaintext, never commit
sentry.properties
android/sentry.properties
ios/sentry.properties
.sentryclirc
scripts/.jwt
.claude/worktrees/

# Visual brainstorming companion (local mockups)
.superpowers/

# Local Expo module build output — regenerated, never commit
modules/*/android/build/
