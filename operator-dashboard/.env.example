# Copy to .env and fill in. Never commit .env.
#
# These are the SAME Supabase project the mobile app uses. The anon key is
# public by design — Row Level Security is what protects the data, not this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Testing only. Shows every trip you host, not just operator ('C') trips.
# Leave unset in production.
VITE_ALLOW_ALL_HOSTED_TRIPS=false

# Which Stripe payments count as real money.
#
# This MUST match the database's `app.stripe_livemode` setting, which reads as
# FALSE when it is unset — so right now, TEST payments count as real, and the
# mobile app already tells travelers their sandbox deposit is paid. If this
# site disagreed, an operator would read "$0 collected" for a settled deposit.
#
# It is the THIRD flag that has to flip together with the live Stripe key:
#   app.stripe_livemode          database setting
#   EXPO_PUBLIC_STRIPE_LIVEMODE  mobile app
#   VITE_STRIPE_LIVEMODE         this site
#
# Get it wrong and the totals are quietly wrong. The money page warns when it
# finds payments in the mode it is not counting, which is the usual symptom.
VITE_STRIPE_LIVEMODE=false
